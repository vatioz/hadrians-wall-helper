{
  "name": "Hadrian's Wall Helper",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:26-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "React development server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm ci --engine-strict",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "remoteUser": "node"
}
